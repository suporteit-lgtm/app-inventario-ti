{
  "expo": {
    "name": "Inventário de Equipamentos",
    "slug": "inventario-ti",
    "scheme": "inventarioti",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f2f4f8",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.locgrupo.inventario",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "br.com.locgrupo.inventario",
      "adaptiveIcon": {
        "backgroundColor": "#F2F4F8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "O app usa a câmera para escanear QR codes e fotografar equipamentos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#f2f4f8"
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "123b1247-9162-4b69-8382-b6ef4820fb69"
      }
    },
    "owner": "locagora-ti"
  }
}
